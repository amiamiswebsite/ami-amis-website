        "$type": "color",
        "$value": "{palette.blue.500}"
      }
    }
  },
  "layout": {
    "contentMax": {
      "$type": "dimension",
      "$value": {
        "value": 1280,
        "unit": "px"
      }
    },
    "visualMax": {
      "$type": "dimension",
      "$value": {
        "value": 1440,
        "unit": "px"
      }
    },
