      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pagePaddingTablet": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "pagePaddingDesktop": {
      "$type": "dimension",
      "$value": "{space.7}"
    }
