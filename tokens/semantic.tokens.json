{
  "$description": "Ami Amis semantic tokens. Aliassen naar reference tokens op basis van UI-rol.",
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{palette.paper.500}"
      },
      "brand": {
        "$type": "color",
        "$value": "{palette.red.500}"
      },
      "accentYellow": {
        "$type": "color",
        "$value": "{palette.yellow.500}"
      },
      "accentBlue": {
        "$type": "color",
        "$value": "{palette.blue.500}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{palette.ink.500}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{palette.ink.500}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{palette.paper.500}"
      },
      "link": {
        "$type": "color",
        "$value": "{palette.blue.500}"
      },
      "brandStrong": {
        "$type": "color",
        "$value": "{palette.red.700}"
      }
    },
    "border": {
