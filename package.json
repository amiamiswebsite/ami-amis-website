{
  "name": "ami-amis-landing",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "assets:baseline": "node scripts/audit-assets.mjs --write",
    "assets:check": "node scripts/audit-assets.mjs --check",
    "capture:routes": "node scripts/capture-routes.mjs",
    "capture:sjb-showcase": "node scripts/capture-sjb-showcase.mjs",
    "check:generated-root": "node scripts/check-generated-root.mjs",
    "lint": "eslint app src scripts tests next.config.mjs playwright.config.mjs eslint.config.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "style:check": "stylelint \"app/styles/**/*.css\"",
    "build": "pnpm tokens:build && next build",
    "build:pages": "NEXT_PUBLIC_SITE_URL=https://amiamis.com pnpm build",
    "build:pages:preview": "NEXT_PUBLIC_BASE_PATH=/ami-amis-website NEXT_PUBLIC_SITE_URL=https://amiamiswebsite.github.io/ami-amis-website pnpm build",
    "preview": "node scripts/serve-static.mjs",
    "test:smoke": "playwright test tests/e2e/smoke.spec.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.mjs",
    "test:content": "playwright test tests/e2e/content.spec.mjs tests/e2e/copy-parity.spec.mjs",
    "test:interaction": "playwright test tests/e2e/interactions.spec.mjs",
    "test:zoom": "playwright test tests/e2e/zoom.spec.mjs",
    "test:visual": "playwright test tests/e2e/visual.spec.mjs",
    "test:reduced-motion": "playwright test tests/e2e/reduced-motion.spec.mjs",
    "test": "playwright test",
    "test:pages": "EXPECTED_SITE_URL=https://amiamis.com playwright test",
    "test:pages:preview": "TEST_BASE_PATH=/ami-amis-website EXPECTED_SITE_URL=https://amiamiswebsite.github.io/ami-amis-website playwright test",
    "lighthouse": "lhci autorun",
    "quality:fast": "pnpm tokens:check && pnpm assets:check && pnpm check:generated-root && pnpm lint && pnpm format:check && pnpm style:check",
    "quality": "pnpm quality:fast && pnpm build:pages && pnpm test:pages",
    "start": "next start"
  },
  "dependencies": {
    "@vimeo/player": "^2.30.4",
    "matter-js": "^0.20.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
}
