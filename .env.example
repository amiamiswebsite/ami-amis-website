# Canonical production origin. Local development still runs at localhost.
NEXT_PUBLIC_SITE_URL=https://amiamis.com

# Leave empty for the custom domain. Only set this for a legacy repository-path preview.
NEXT_PUBLIC_BASE_PATH=

# Optional static-export-compatible form endpoint. Leave blank to use the
# explicit mailto fallback; never commit provider secrets here.
NEXT_PUBLIC_CONTACT_ENDPOINT=
